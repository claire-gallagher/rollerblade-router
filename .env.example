# Copy to .env and fill in. .env is gitignored.
# Stadia Maps API key (free at https://client.stadiamaps.com/signup/): Valhalla routing + geocoding.
STADIA_API_KEY=

# NYC Geoclient v2 key (free at https://api-portal.nyc.gov/, subscribe to Geoclient v2 User): addresses + intersections.
NYC_GEOCLIENT_KEY=

# Optional: where the LiDAR raster lives (default data/manhattan_dem_1m.tif, built by scripts/prep_lidar.py).
# DEM_PATH=
